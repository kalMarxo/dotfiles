{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "source": "~/.config/fastfetch/logos/arch_red.txt",
    "color": {
      "1": "red",
      "2": "white"
    },
    "padding": { "top": 1, "right": 2 }
  },

  "modules": [
    { "type": "custom", "format": "──────────────────   SYSTEM ─────────────────────" },
    { "type": "os", "key": "OS", "keyColor": "red" },
    { "type": "kernel", "key": "Kernel", "keyColor": "red" },
    { "type": "packages", "key": "Packages", "keyColor": "red" },
    { "type": "host", "key": "Host", "keyColor": "red" },

    { "type": "custom", "format": "────────────────── 🪟  INTERFACE ─────────────────" },
    { "type": "de", "key": "DE", "keyColor": "magenta" },
    { "type": "wm", "key": "WM", "keyColor": "magenta" },
    { "type": "wmtheme", "key": "Theme", "keyColor": "magenta" },
    { "type": "icons", "key": "Icons", "keyColor": "magenta" },
    { "type": "font", "key": "Font", "keyColor": "magenta" },
    { "type": "terminal", "key": "Terminal", "keyColor": "magenta" },

    { "type": "custom", "format": "────────────────── ⚙️  HARDWARE ──────────────────" },
    { "type": "cpu", "key": "CPU", "keyColor": "cyan" },
    { "type": "gpu", "key": "GPU", "keyColor": "cyan" },
    { "type": "memory", "key": "Memory", "keyColor": "cyan" },
    { "type": "disk", "key": "Disk", "keyColor": "cyan" },

    { "type": "custom", "format": "──────────────────────────────────────────────────" }
  ]
}


